# PostgreSQL —— 部署前请改为强随机密码
POSTGRES_DB=flowmind
POSTGRES_USER=flowmind
POSTGRES_PASSWORD=replace_with_strong_postgres_password

# Backend
DATABASE_URL=postgresql+asyncpg://flowmind:replace_with_strong_postgres_password@postgres:5432/flowmind
REDIS_URL=redis://redis:6379/0

# LLM
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# JWT —— 必须 >= 32 字符随机字符串；可用 `python -c "import secrets;print(secrets.token_hex(48))"` 生成
JWT_SECRET=replace_with_random_64_byte_hex_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# 搜索
TAVILY_API_KEY=your_tavily_api_key_here

# CORS 允许来源（逗号分隔；如生产环境填多个 origin）
CORS_ALLOW_ORIGINS=http://localhost:3000

# 运行环境：本地开发用 development（彩色日志 + 开放 dev 接口）；线上务必保持 production
APP_ENV=development

# SMTP 邮件
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=your_smtp_user
SMTP_USE_TLS=true
